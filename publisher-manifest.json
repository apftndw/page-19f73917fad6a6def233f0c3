px;font-size:16px;font-weight:600;color:var(--navy)}\n  .steps p{margin:0;max-width:48em;font-size:14px;line-height:1.88;color:var(--muted)}\n\n  /* 常见问题 */\n  .faq-group{margin-bottom:46px}\n  .faq-group:last-child{margin-bottom:0}\n  .faq-group > h3{margin:0 0 16px;font-size:12px;font-weight:600;letter-spacing:.24em;color:var(--amber);text-transform:uppercase}\n  .qa{padding:18px 0;border-top:1px solid var(--line)}\n  .qa h4{margin:0 0 8px;font-size:15.5px;font-weight:600;color:var(--navy)}\n  .qa p{margin:0;max-width:52em;font-size:14px;line-height:1.92;color:var(--muted)}\n\n  /* 页脚 */\n  footer{background:var(--navy);color:rgba(255,255,255,.58);margin-top:0}\n  .foot-inner{max-width:1120px;margin:0 auto;padding:46px 24px;font-size:12.5px;line-height:1.95}\n  .foot-brand{margin:0 0 12px;color:#fff;font-size:14px;letter-spacing:.32em;font-weight:600}\n  .foot-links{display:flex;flex-wrap:wrap;gap:20px;margin:18px 0 0;font-size:12.5px}\n  .foot-links a{color:rgba(255,255,255,.68);text-decoration:none}\n  .foot-links a:hover{color:var(--amber-light)}\n\n  @media (max-width:880px){\n    .hero-inner{grid-template-columns:1fr;gap:40px;padding:56px 24px 64px}\n    .plan{grid-template-columns:1fr;gap:22px}\n    .plan:nth-of-type(2),.plan:nth-of-type(3){margin-left:0}\n    .plan ul{grid-template-columns:1fr}\n    .section{padding:60px 0}\n  }\n  @media (max-width:620px){\n    .topbar-inner{flex-direction:column;align-items:flex-start;gap:8px}\n    .nav-links{gap:16px;font-size:12.5px;width:100%}\n    .steps li{padding-left:46px}\n    .steps li::before{font-size:19px}\n    .price strong{font-size:30px}\n  }\n</style><header class=\"topbar\">\n  <div class=\"topbar-inner\">\n    <a class=\"brand\" href=\"#top\">小牛</a>\n    <nav class=\"nav-links\">\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#guide\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <section class=\"hero\">\n    <div class=\"hero-inner\">\n      <div>\n        <p class=\"eyebrow\">小牛 · 资料整理页</p>\n        <h1>小牛<span>机场</span>套餐、客户端与使用说明</h1>\n        <p class=\"lead\">这一页把三件事写在同一个地方：小牛的套餐分哪几档、各档包含什么；客户端可以通过什么方式获取、使用前需要注意什么；以及连接过程中遇到问题时，应当按什么顺序排查。页面内容为整理与说明，不提供下载地址、不承接交易；套餐价格、权益与客户端适配情况，请以下单页和实际提供服务的页面展示为准。</p>\n        <div class=\"hero-actions\">\n          <a class=\"btn btn-amber\" href=\"#plans\">查看套餐</a>\n          <a class=\"btn btn-ghost\" href=\"#guide\">阅读使用说明</a>\n        </div>\n      </div>\n      <aside class=\"panel\">\n        <p class=\"panel-title\">首屏速览</p>\n        <div class=\"panel-row\"><span class=\"k\">套餐档位</span><span class=\"v\">基础 / 旗舰 / 团队</span></div>\n        <div class=\"panel-row\"><span class=\"k\">起步月付</span><span class=\"v\"><b>¥15</b> / 月</span></div>\n        <div class=\"panel-row\"><span class=\"k\">年付区间</span><span class=\"v\">¥150 – ¥850</span></div>\n        <div class=\"panel-row\"><span class=\"k\">每月流量</span><span class=\"v\">100GB / 300GB / 1000GB</span></div>\n        <div class=\"panel-row\"><span class=\"k\">同时在线</span><span class=\"v\">3 / 5 / 20 台</span></div>\n        <div class=\"panel-row\"><span class=\"k\">计费周期</span><span class=\"v\">月付 · 年付</span></div>\n        <p class=\"panel-note\">以上为页面整理的摘要信息，如与实际展示存在差异，以实际页面为准。</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"rule\"></div>\n      <h2>套餐与价格</h2>\n      <p class=\"section-intro\">三档套餐按每月流量、同时在线设备数与线路类型逐级提高，下方排列从低到高展开。价格与权益为整理内容，最终以实际下单页面展示为准。</p>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <div>\n            <span class=\"plan-no\">01</span>\n            <h3>基础版</h3>\n            <p class=\"desc\">面向单人日常使用，以基础线路和通用流媒体需求为主。</p>\n            <p class=\"price\"><strong>¥15</strong><span>/ 月</span></p>\n            <p class=\"annual\">按年付 <b>¥150 / 年</b></p>\n          </div>\n          <div>\n            <ul>\n              <li>每月 100GB 高速流量</li>\n              <li>最多 3 台设备同时在线</li>\n              <li>支持基础流媒体解锁</li>\n              <li>通用线路节点池</li>\n            </ul>\n            <a class=\"plan-link\" href=\"#faq\">查看计费说明</a>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <span class=\"plan-no\">02</span>\n            <h3>旗舰版<span class=\"tag\">主推</span></h3>\n            <p class=\"desc\">在流量、设备数与线路类型上同时放宽，适合多设备与游戏场景。</p>\n            <p class=\"price\"><strong>¥35</strong><span>/ 月</span></p>\n            <p class=\"annual\">按年付 <b>¥350 / 年</b></p>\n          </div>\n          <div>\n            <ul>\n              <li>每月 300GB 高速流量</li>\n              <li>最多 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n            <a class=\"plan-link\" href=\"#faq\">查看计费说明</a>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <span class=\"plan-no\">03</span>\n            <h3>团队版</h3>\n            <p class=\"desc\">面向多人共享与统一管理的使用场景，流量与设备额度最高。</p>\n            <p class=\"price\"><strong>¥85</strong><span>/ 月</span></p>\n            <p class=\"annual\">按年付 <b>¥850 / 年</b></p>\n          </div>\n          <div>\n            <ul>\n              <li>每月 1000GB 高速流量</li>\n              <li>最多 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <a class=\"plan-link\" href=\"#faq\">查看计费说明</a>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section alt\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"rule\"></div>\n      <h2>客户端</h2>\n      <p class=\"section-intro\">本页不提供下载地址，也不提供安装包或镜像。下面按常见的使用形态说明客户端的获取来源与使用注意事项，具体版本、适配系统与安装方式，请以实际提供服务的页面说明为准。</p>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <span class=\"num\">01</span>\n          <h3>桌面客户端</h3>\n          <p>在电脑上使用时，一般通过桌面客户端连接。安装前先确认系统版本与安装包来源，安装完成后按提示导入配置信息。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"num\">02</span>\n          <h3>移动客户端</h3>\n          <p>手机和平板上的使用方式以移动客户端为主。安装包应来自实际提供的分发渠道，不建议从陌生来源获取安装文件。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"num\">03</span>\n          <h3>路由与局域网</h3>\n          <p>需要让局域网内多台设备共享时，可参考客户端或路由配置说明操作。改动前建议记录原有设置，便于后续恢复。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"num\">04</span>\n          <h3>更新与备份</h3>\n          <p>更新客户端前先备份现有配置与账号信息。更新后若出现连接异常，可先回退到更新前的版本，再逐项排查。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"rule\"></div>\n      <h2>使用说明</h2>\n      <p class=\"section-intro\">以下顺序适用于首次使用。遇到问题时，建议按相反顺序回查：先确认账号与套餐状态，再看客户端设置，最后检查本机网络环境。</p>\n\n      <ol class=\"steps\">\n        <li>\n          <h3>选择套餐</h3>\n          <p>根据同时在线的设备数量和每月大致流量需求选择档位。设备数按同时在线计算，流量按月计算，两者都会影响使用体验。</p>\n        </li>\n        <li>\n          <h3>获取客户端</h3>\n          <p>从实际提供的渠道获取对应平台的客户端。本页不提供下载链接，也不做安装包分发，任何以本页名义提供的下载地址都不应采信。</p>\n        </li>\n        <li>\n          <h3>导入配置</h3>\n          <p>按客户端提示导入配置信息，完成后确认账号状态显示正常，再进入下一步。配置信息不要转发给他人，也不建议截图公开分享。</p>\n        </li>\n        <li>\n          <h3>选择线路</h3>\n          <p>初次使用可先保留默认线路。若当前线路延迟偏高，再在客户端内切换其他线路做对比，避免同时改动多项设置，以免无法判断是哪一项导致变化。</p>\n        </li>\n        <li>\n          <h3>核对额度</h3>\n          <p>连接前确认套餐仍在有效期内，且同时在线设备数没有超过所选档位的上限。超出设备数限制时，通常表现为后连接的设备无法正常使用。</p>\n        </li>\n        <li>\n          <h3>遇到问题时</h3>\n          <p>先断开重连，再检查本机网络，然后切换线路。若仍然无法连接，保留界面上的报错信息，通过实际提供服务的页面所列渠道进行反馈。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section class=\"section alt\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"rule\"></div>\n      <h2>常见问题</h2>\n      <p class=\"section-intro\">问题按主题分为三组：套餐与计费、客户端与设备、连接与排错。答案基于本页整理的信息，未涉及的内容不作推断。</p>\n\n      <div class=\"faq-group\">\n        <h3>套餐与计费</h3>\n\n        <div class=\"qa\">\n          <h4>小牛有哪几档套餐？</h4>\n          <p>页面整理为三档：基础版 ¥15/月（年付 ¥150）、旗舰版 ¥35/月（年付 ¥350）、团队版 ¥85/月（年付 ¥850）。如与下单页展示不一致，以下单页为准。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>三档套餐的主要差别是什么？</h4>\n          <p>差别集中在三处：每月流量分别为 100GB、300GB 和 1000GB；同时在线设备数分别为 3 台、5 台和 20 台；线路与支持方式依次为通用线路节点池、IPLC 专线游戏加速优化与优先工单、VIP 专属高带宽节点与专属客户经理。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>年付和月付应该怎么选？</h4>\n          <p>年付一次结清，适合已经确定长期使用的场景；月付更灵活，适合先按一个月观察实际用量再做决定。两种周期的具体金额以下单页展示为准。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>流量用完了会怎样处理？</h4>\n          <p>页面没有给出超出额度后的处理规则，因此这里不作推断。建议在选档时按实际用量留出余量，用量波动较大的场景可以直接考虑更高一档。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>客户端与设备</h3>\n\n        <div class=\"qa\">\n          <h4>客户端在哪里获取？</h4>\n          <p>本页不提供下载地址与安装包，也不代发任何客户端文件。客户端的获取方式与版本信息，请以实际提供服务的页面说明为准。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>一个账号可以几台设备同时使用？</h4>\n          <p>按档位分别是 3 台、5 台和 20 台。这里的数字指同时在线数，不是累计登录过的设备总数，离线后该设备不再占用名额。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>支持哪些操作系统？</h4>\n          <p>本页不列举具体系统版本。不同客户端形态的适配情况会随版本更新而变化，请以实际下载页给出的系统要求为准。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>更换设备使用需要额外付费吗？</h4>\n          <p>页面没有给出更换设备的计费规则，这里不作判断。只要同时在线数没有超过所选档位的上限，就不需要为单台设备单独开通。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>连接与排错</h3>\n\n        <div class=\"qa\">\n          <h4>连不上时应该先检查什么？</h4>\n          <p>按顺序看四项：一是套餐是否仍在有效期，二是同时在线设备是否已达上限，三是客户端内当前线路是否可用，四是本机网络是否正常。四项确认完再考虑更换线路或重装客户端。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>速度不理想该怎么处理？</h4>\n          <p>先在客户端内切换线路做对比，不要只凭单条线路下结论；其次确认当前时段是否为使用高峰；如果使用旗舰版或团队版，可以优先尝试专线节点与高带宽节点。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>修改设置后反而不通了怎么办？</h4>\n          <p>把改动项逐项回退到上一次可用的状态，不要一次恢复全部设置。如果事先有配置备份，直接导入备份是恢复最快的做法。</p>\n        </div>\n\n        <div class=\"qa\">\n          <h4>页面信息与实际看到的页面不一致怎么办？</h4>\n          <p>以实际提供服务的页面展示为准。本页内容用于整理与说明，不构成对价格、权益或服务内容的承诺。</p>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"foot-inner\">\n    <p class=\"foot-brand\">小牛</p>\n    <p>本页为小牛相关的资料整理与说明页面，非品牌方授权页面，也未与任何第三方建立代理关系。页面不提供下载地址，不承接下单与支付。套餐价格、权益、客户端获取方式与适配情况，均以实际提供服务的页面展示为准。</p>\n    <nav class=\"foot-links\">\n      <a href=\"#plans\">套餐与价格</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#guide\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</footer>",
